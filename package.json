{
  "name": "@polytoria-ts/types",
  "version": "1.0.6",
  "description": "Generate TypeScript typedefs from Polytoria's yaml",
  "type": "commonjs",
  "scripts": {
    "generate": "git submodule update --init --recursive && node index.mjs",
    "test": "tsc include/* --noEmit --ignoreConfig"
  },
	"main": "include/polytoria.d.ts",
	"types": "include/polytoria.d.ts",
	"files": [
		"/include/*.d.ts"
	],
  "dependencies": {
    "@polytoria-ts/compiler-types": "3.0.6",
    "glob": "^13.0.6",
    "yaml": "^2.9.1"
  }
}
